# ── 服务 ─────────────────────────────────────────────
PORT=8778
HOST=127.0.0.1
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8790
GATEWAY_URL=http://127.0.0.1:8778

# ── 数据 ─────────────────────────────────────────────
# 相对路径锚在项目根，不跟启动目录走
DB_PATH=./data/hub.db
# 主密钥文件；不设则在 DB_PATH 同目录生成 data/master.key
# MASTER_KEY_FILE=./data/master.key
# 也可以直接注入 32 字节 base64，省掉本地文件
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=

# ── 出网安全 ──────────────────────────────────────────
# 是否允许转发到私网/回环地址（仅本地联调时打开）
ALLOW_PRIVATE_EGRESS=false
# 出网总超时（毫秒）
EGRESS_TIMEOUT_MS=15000
# 单次响应最大字节
EGRESS_MAX_BYTES=2097152

# ── LLM（OpenAI 兼容，可填任意 base_url）──────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=60000
LLM_CONCURRENCY=4
# 关闭后「一键整理」只做规则解析（AI 备注与命名会跳过）
LLM_ENABLED=false

# ── 网关令牌 ──────────────────────────────────────────
# MCP 调网关用的 key（在控制台「密钥与令牌」页生成，不要提交到仓库）
HUB_API_KEY=

# 首次启动会自动创建管理员账号 admin / admin123456，登录后请立刻修改。
# 控制台鉴权走账号密码，不再有 ADMIN_TOKEN。
