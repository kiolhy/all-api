data/**
*.db
*.db-wal
*.db-shm
*.key
*.sqlite
*.sqlite3

# ── 环境变量（含 LLM key、网关 key）──────────────────
.env
.env.local
.env.*.local

# ── 日志与临时文件 ──────────────────────────────────
*.log
logs/
tmp/
.cache/

# ── 编辑器 / 系统 ───────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
